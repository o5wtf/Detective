static func state_line(band_name: String, emotion: String, pressure_value: int, developer: bool) -> String:
	var remark := state_remark(band_name, emotion)
	if not developer:
		return remark
	return "%s, давление %d" % [remark, pressure_value]


static func state_remark(band_name: String, emotion: String) -> String:
	var band_text := "держится уверенно"
	match band_name:
		"tense":
			band_text = "напряжён"
		"nervous":
			band_text = "заметно нервничает"
		"breaking":
			band_text = "на грани"
	var emotion_text := emotion_word(emotion)
	if emotion_text == "" or emotion == "neutral" or _same_stem(band_text, emotion_text):
		return "«%s»" % band_text
	return "«%s», %s" % [band_text, emotion_text]


static func _same_stem(band_text: String, emotion_text: String) -> bool:
	var stem := emotion_text.substr(0, mini(5, emotion_text.length())).to_lower()
	return stem.length() >= 4 and band_text.to_lower().contains(stem)


static func emotion_word(emotion: String) -> String:
	match emotion:
		"calm":
			return "спокоен"
		"neutral":
			return "нейтрален"
		"nervous":
			return "нервничает"
		"scared":
			return "напуган"
		"sad":
			return "подавлен"
		"angry":
			return "злится"
		"controlled":
			return "холоден"
		"contemptuous":
			return "презрителен"
		_:
			return ""


static func error_text(kind: String) -> String:
	match kind:
		"offline":
			return "Нет сети. Проверьте подключение и повторите."
		"timeout":
			return "Модель не ответила вовремя."
		"rate_limited":
			return "Слишком много запросов. Подождите немного."
		"overloaded":
			return "Модель перегружена. Подождите немного."
		"unavailable":
			return "Эта модель недоступна."
		"auth":
			return "Проверьте ключ в настройках."
		"rejected":
			return "Запрос отклонён."
		"server":
			return "Сервис временно недоступен."
		_:
			return "Ход не получился. Попробуйте ещё раз."


static func connection_message(provider: String, result: Dictionary) -> String:
	if provider == "mock":
		return LINK_MOCK
	if result.get("ok", false):
		var model := str(result.get("model", "")).strip_edges()
		var elapsed := float(result.get("elapsed_s", -1.0))
		if model != "" and elapsed >= 0.0:
			return "Связь есть. Ответила %s за %s с." % [model, String.num(elapsed, 1)]
		return LINK_OK
	var message := str(result.get("message", "")).strip_edges()
	if message != "":
		return message
	var kind := str(result.get("error", ""))
	if kind == "":
		return LINK_FAIL
	return error_text(kind)


static func present_hint(title: String) -> String:
	return "Предъявить: «%s»?" % title


static func presented_line(title: String) -> String:
	return "[предъявлена улика: %s]" % title


static func shown_evidence(title: String) -> String:
	return "Вы показали: %s" % title


static func confront_line(title: String, quote: String) -> String:
	return "предъявили «%s» против слов «%s»" % [title, quote]


static func player_verdict(verdict: String) -> String:
	match verdict:
		"repeat":
			return VERDICT_REPEAT
		"refuted":
			return VERDICT_REFUTED
		"completed":
			return VERDICT_COMPLETED
		"already":
			return VERDICT_ALREADY
		_:
			return VERDICT_HOLD


static func also_broken(names: String) -> String:
	return "разоблачено также: %s" % names


static func evidence_opened(title: String) -> String:
	return "Открыта улика: %s" % title


static func contradiction_line(description: String) -> String:
	var body := description.strip_edges()
	if body == "":
		return "Найдено противоречие"
	return "Найдено противоречие: %s" % body


static func lie_broken(agent_name: String) -> String:
	return "%s больше не может это отрицать" % agent_name


static func demands(agent_name: String) -> String:
	return "%s требует доказательств" % agent_name


static func thinking(agent_name: String) -> String:
	return "%s думает…" % agent_name


static func evidence_kind(type_name: String) -> String:
	match type_name:
		"document", "документ":
			return "документ"
		"item", "object", "предмет":
			return "предмет"
		"place", "location", "место":
			return "место"
		"scene", "сцена":
			return "сцена"
		_:
			return type_name
